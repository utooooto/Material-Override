msgstr "Write the overrides into the original material asset and remove this component. Affects every object that uses it."

msgid "insp_bake_readonly"
msgstr "The original material cannot be edited here (it is inside a model file or a package). Use 'Bake as New Material' instead."

msgid "insp_bake_dlg_title"
msgstr "Bake into Original Material"

msgid "insp_bake_dlg_msg"
msgstr "This changes the asset '{0}' for every object that uses it, then removes this component.\nThe asset change may not be fully undoable."

msgid "insp_bake_dlg_msg_keep"
msgstr "This changes the asset '{0}' for every object that uses it.\nThis component comes from a prefab and cannot be removed from here, so it stays.\nThe asset change may not be fully undoable."

msgid "insp_bake_ok"
msgstr "Bake"

msgid "insp_bake_cancel"
msgstr "Cancel"

msgid "insp_no_renderer"
msgstr "Put this component on a GameObject that has a Renderer."

msgid "insp_no_target"
msgstr "The selected slot has no material."

msgid "insp_overrides"
msgstr "Overrides: {0}"

msgid "insp_clear"
msgstr "Clear All Overrides"

msgid "insp_missing_props"
msgstr "{0} override(s) are for properties the current shader does not have, so they are skipped: {1}\nYou can remove them in the list below, or ignore this."

msgid "insp_revert_tip"
msgstr "Remove this override (back to the target material's value)"

msgid "insp_kw_on"
msgstr "keyword: on"

msgid "insp_kw_off"
msgstr "keyword: off"

msgid "insp_result"
msgstr "Result (what the build will use)"

